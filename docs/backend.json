
{
  "entities": {
    "Enrollment": {
      "title": "Student Enrollment",
      "description": "Stores multi-step enrollment applications including parents, multiple students, and document files.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "submitted", "reviewed", "approved", "rejected"] },
        "lang": { "type": "string" },
        "parent1Name": { "type": "string" },
        "parent1Phone": { "type": "string" },
        "parent1Email": { "type": "string" },
        "address": { "type": "object" },
        "students": { "type": "array" },
        "programOption": { "type": "string" },
        "paymentTier": { "type": "string" },
        "files": { "type": "array" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Student": {
      "title": "Active Student",
      "description": "Records of approved students with academic and financial tracking.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "enrollmentId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "graduated", "on-hold"] },
        "gradeLevel": { "type": "string" },
        "academicPlan": {
          "type": "object",
          "properties": {
            "courses": { "type": "array" },
            "progress": { "type": "number" },
            "graduationYear": { "type": "number" }
          }
        },
        "financialLedger": {
          "type": "object",
          "properties": {
            "totalDue": { "type": "number" },
            "totalPaid": { "type": "number" },
            "payments": { "type": "array" },
            "lastPaymentDate": { "type": "string" }
          }
        }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "Collection of all applications."
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of active student records."
    }
  }
}
