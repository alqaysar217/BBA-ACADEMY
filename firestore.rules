
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Enrollments collection
    match /enrollments/{enrollmentId} {
      // Allow anyone to create an enrollment (public registration)
      // Allow users to read/update their own drafts
      allow create: if true;
      allow get, update: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.email.endsWith('@baneenbanaat.org'));
      
      // Admin Access: Allow read and list if the user is logged in with an academy email
      // This is a simplified admin check for the prototype
      allow list: if request.auth != null && request.auth.token.email.endsWith('@baneenbanaat.org');
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.email.endsWith('@baneenbanaat.org'));
    }
  }
}
