
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Enrollments collection
    match /enrollments/{enrollmentId} {
      // Allow anyone to create an enrollment (public registration)
      allow create: if true;
      
      // FOR PROTOTYPE TESTING: Allow public read and list so the 'admin/admin' 
      // bypass works without real Firebase Authentication.
      // IN PRODUCTION: These should be restricted to authenticated admins only.
      allow list: if true;
      allow get: if true;
      
      // Allow update for testing
      allow update: if true; 
    }
  }
}
