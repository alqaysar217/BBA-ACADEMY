
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // قواعد وصول شاملة لضمان استقرار عمليات الإرسال والمراجعة
    match /{document=**} {
      allow read, write: if true;
    }

    // ملاحظة: تم تحديث الأذونات للسماح بالكتابة العامة على enrollments لضمان نجاح عملية التسجيل
  }
}
