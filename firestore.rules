
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // قواعد وصول مفتوحة لضمان عمل كافة العمليات البرمجية بشكل مستقر أثناء التطوير
    match /{document=**} {
      allow read, write: if true;
    }

    // تم تحديث الأذونات للسماح بالكتابة العامة لضمان نجاح إرسال الطلبات (Enrollments)
  }
}