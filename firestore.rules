
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // السماح بالوصول الكامل لمجموعة طلبات التسجيل لدعم الربط الحقيقي
    // هذا التحديث يفتح صلاحية "الكتابة" (Write) التي تسببت في الخطأ الأخير
    // مشروع: studio-2654552044-6b576 | تحديث: 2024-05-20
    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // السماح بالوصول الكامل لجميع المسارات الأخرى مؤقتاً لضمان عدم تعطل الاستمارة
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
