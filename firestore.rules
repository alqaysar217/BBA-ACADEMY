
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. القبول والتسجيل - السماح بالوصول الكامل للإدارة وللمتقدمين الجدد
    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // 2. سجل الطلاب - السماح بالوصول الكامل للإدارة
    match /students/{studentId} {
      allow read, write: if true;
    }

    // 3. إدارة المستخدمين - السماح بالوصول الكامل لمديري النظام
    match /admin_users/{userId} {
      allow read, write: if true; 
    }

    // 4. قاعدة عامة للتطوير - تضمن عدم توقف أي جزء من النظام حالياً
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
