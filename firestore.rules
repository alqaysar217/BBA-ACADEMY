
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // مجموعة طلبات التسجيل
    match /enrollments/{enrollmentId} {
      // السماح للجميع بإنشاء طلب (للسماح للزوار بالتسجيل)
      allow create: if true;
      
      // وضع الاختبار: السماح بالقراءة والتحديث للجميع لدعم حساب admin/admin التجريبي
      // في النسخة النهائية، يجب حصر هذه الصلاحيات بالمستخدمين المسجلين كمسؤولين فقط
      allow read, list, get, update, delete: if true;
    }

    // السماح بالقراءة والكتابة العامة لأي مسارات أخرى في وضع التطوير
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
