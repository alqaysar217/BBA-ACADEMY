
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // السماح بالوصول الكامل لجميع المجموعات لدعم التطوير والاختبار مع المشروع الحقيقي
    // ملاحظة: تأكد من تفعيل Firestore في لوحة تحكم Firebase للمشروع الجديد (studio-2654552044-6b576)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
