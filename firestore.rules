
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // تحديث أمان: السماح بالوصول الكامل لضمان نجاح الربط مع قاعدة البيانات الحقيقية
    // التحديث الأخير: 2024-05-21 00:00:00
    // مشروع: studio-2654552044-6b576
    
    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
