
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // السماح بالوصول الكامل لمجموعة enrollments لضمان نجاح التسجيل
    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // السماح بالوصول العام لكافة المسارات الأخرى (لأغراض التطوير)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
