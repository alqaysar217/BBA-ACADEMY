
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // قواعد حماية شاملة للوحة الإدارة والتطوير
    // تضمن هذه القواعد وصولاً كاملاً لكافة الأقسام (المستخدمين، الطلاب، الطلبات)
    match /{document=**} {
      allow read, write: if true;
    }

    // تفعيل التحديث الفوري للقواعد في الخادم
    // Last Update: 2025-05-20
  }
}
