
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public write access to enrollments for new submissions
    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // Allow access to students and admin metadata
    match /students/{studentId} {
      allow read, write: if true;
    }

    match /admin_users/{userId} {
      allow read, write: if true;
    }

    // قواعد حماية شاملة للوحة الإدارة والتطوير
    match /{document=**} {
      allow read, write: if true;
    }

    // التحديث: 2026-10-24 - تنشيط القواعد لمعالجة أخطاء الأذونات في الإرسال
  }
}
