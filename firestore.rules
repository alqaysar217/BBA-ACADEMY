
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // فتح الوصول الكامل لجميع المسارات لدعم الربط الأولي والاختبار
    // ملاحظة: بمجرد استلام أول طلب، يمكنك تقييد الصلاحيات للمسؤولين فقط
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
